{
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },

  "ConnectionStrings": {
    "DefaultConnection": "Server=<set in .env>;Database=Complexion;User Id=<set in .env>;Password=<set in .env>;TrustServerCertificate=True;"
  },

  "Jwt": {
    "Issuer": "Complexion.Api",
    "Audience": "Complexion.Client",
    "ExpirationInMinutes": 60
  }
}