{
    "AllowedHosts": "*",
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
              "Microsoft": "Warning"
            }
        },
        "WriteTo": [
            { "Name": "Console" },
            {
                "Name": "File",
              "Args": {
                "path": "logs/log-.txt",
                "rollingInterval": "Day"
              }
            }
        ],
        "Enrich": [ "FromLogContext" ]
    }
}