                      "const stamp = Date.now();\r\npm.environment.set(\"username\", \"pmuser\" + stamp);\r\npm.environment.set(\"email\", \"pmuser\" + stamp + \"@email.com\");\r\npm.environment.set(\"password\", \"TestP@ssword2026\");"
