            {
              "name": "/api/Auth/Me - authenticated",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Me returns the logged-in user\", function () {\n    const jsonData = pm.response.json();\n    pm.expect(jsonData.username).to.eql(pm.environment.get(\"username\"));\n});\n\npm.test(\"Response body contains expected fields\", function () {\n    const jsonData = pm.response.json();\n    pm.expect(jsonData).to.have.property(\"userId\");\n    pm.expect(jsonData).to.have.property(\"username\");\n});\n\npm.test(\"Response body fields are non-empty\", function () {\n    const jsonData = pm.response.json();\n    pm.expect(jsonData.userId).to.not.be.empty;\n    pm.expect(jsonData.username).to.not.be.empty;\n});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/Auth/Me",
